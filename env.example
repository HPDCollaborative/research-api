# Search provider: "local" for Fuse.js (no server needed), "meilisearch" for Meilisearch
SEARCH_TYPE=local

# Meilisearch Host URL (only needed if SEARCH_TYPE=meilisearch)
SEARCH_HOST=https://your-meilisearch-host/

# Meilisearch Public API Key - used by frontend for search queries
SEARCH_KEY=your-public-api-key

# Meilisearch Admin API Key - used for indexing during build
ADMIN_KEY=your-admin-api-key

# Meilisearch Index Name
INDEX_NAME=research-api-docs

# Documentation repository URL (GitHub SSH or HTTPS)
REPO_URL="https://github.com/HPDCollaborative/research-api-documents.git"

# Doc version branches to pull from the repository (JSON array)
# Each version should be a branch name in the REPO_URL repository
DOC_VERSIONS=["2.2", "2.3"]
